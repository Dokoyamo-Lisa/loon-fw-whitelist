#!name=Firewall Auto-Whitelist (po0)
#!desc=Adds this device's current exit IP to your po0 machines' firewall whitelist when the network changes and every minute while connected.
#!author=Dokoyamo-Lisa
#!homepage=https://github.com/Dokoyamo-Lisa/loon-fw-whitelist

[Argument]
api = input,"https://124.221.69.228",tag=API base URL,desc=po0 firewall API. Leave as is
tokens = input,"",tag=po0 tokens,desc=pgnfw_ tokens. One per machine. Separate several with | and add @N to pin one to slot N (pgnfw_xxx@0)
notify = select,"once","changes","always",tag=Notify,desc=once = first success per network or reconnect then quiet. changes = when the IP or result changes. always = after every request. Failures after 3 attempts and manual runs always notify

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
network-changed script-path=https://raw.githubusercontent.com/Dokoyamo-Lisa/loon-fw-whitelist/main/fw-whitelist.js, timeout=60, tag=po0-fw-event, argument=[{api},{tokens},{notify}]
cron "* * * * *" script-path=https://raw.githubusercontent.com/Dokoyamo-Lisa/loon-fw-whitelist/main/fw-whitelist.js, timeout=60, tag=po0-fw-cron, argument=[{api},{tokens},{notify}]
generic script-path=https://raw.githubusercontent.com/Dokoyamo-Lisa/loon-fw-whitelist/main/fw-whitelist.js, timeout=60, tag=po0-fw-manual, img-url=checkmark.shield.system, argument=[{api},{tokens},{notify}]
