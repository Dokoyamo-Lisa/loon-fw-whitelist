#!name=Firewall Auto-Whitelist
#!desc=Adds this device's current exit IP to your server's firewall whitelist when the network changes and every minute while connected. Fork and replace fw.example.com with your API host before installing.
#!author=Dokoyamo-Lisa
#!homepage=https://github.com/Dokoyamo-Lisa/loon-fw-whitelist

[Argument]
api = input,"https://fw.example.com",tag=API base URL,desc=Your whitelist server. No trailing slash
tokens = input,"",tag=Tokens,desc=One per machine. Separate several with | and add @N to pin one to slot N (abc123@0)
notify = select,"once","changes","always",tag=Notify,desc=once = first success per network or reconnect then quiet. changes = when the IP or result changes. always = after every request. Failures after 3 attempts and manual runs always notify

[Rule]
DOMAIN,fw.example.com,DIRECT

[Script]
network-changed script-path=https://raw.githubusercontent.com/Dokoyamo-Lisa/loon-fw-whitelist/main/fw-whitelist.js, timeout=60, tag=fw-whitelist-event, argument=[{api},{tokens},{notify}]
cron "* * * * *" script-path=https://raw.githubusercontent.com/Dokoyamo-Lisa/loon-fw-whitelist/main/fw-whitelist.js, timeout=60, tag=fw-whitelist-cron, argument=[{api},{tokens},{notify}]
generic script-path=https://raw.githubusercontent.com/Dokoyamo-Lisa/loon-fw-whitelist/main/fw-whitelist.js, timeout=60, tag=fw-whitelist-manual, img-url=checkmark.shield.system, argument=[{api},{tokens},{notify}]
